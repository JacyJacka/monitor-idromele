{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/conferma_push.py\" || py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/conferma_push.py\""
          }
        ]
      }
    ]
  }
}
